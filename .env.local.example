# ── Required ──────────────────────────────────────────────────────────────────
# Your Reactor API key (starts with rk_), server-side only. Get one at
# https://www.reactor.inc/ (account → API keys). The app/api/reactor/token route
# exchanges it for short-lived browser JWTs; the key itself never ships to the
# browser.
REACTOR_API_KEY=rk_your_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Point at a different Reactor API base URL. Defaults to https://api.reactor.inc.
# REACTOR_API_URL=https://api.reactor.inc
